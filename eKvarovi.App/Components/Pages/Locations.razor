@page "/locations"
@rendermode InteractiveServer
@using eKvarovi.Shared.Dtos
@using eKvarovi.App.Services
@using eKvarovi.App.Components.Dialogs
@using eKvarovi.App.Services
@inject CurrentUserService CurrentUser
@inject LocationService LocationService
@inject LookupService LookupService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Lokacije</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Lokacije</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_search"
                          Label="Pretraga"
                          Placeholder="Naziv, adresa ili grad"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="400"
                          OnDebounceIntervalElapsed="LoadData" />
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="int?"
                       Value="_locationTypeId"
                       ValueChanged="OnTypeChanged"
                       Label="Vrsta lokacije"
                       Clearable="true">
                @foreach (var type in _locationTypes)
                {
                    <MudSelectItem T="int?" Value="@((int?)type.Id)">@type.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="bool?"
                       Value="_isActive"
                       ValueChanged="OnActiveChanged"
                       Label="Status"
                       Clearable="true">
                <MudSelectItem T="bool?" Value="@((bool?)true)">Aktivne</MudSelectItem>
                <MudSelectItem T="bool?" Value="@((bool?)false)">Neaktivne</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ResetFilters"
                       FullWidth="true">
                Poništi
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h6">Pronađeno: @_items.Count</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreate">
            Nova lokacija
        </MudButton>
    </div>

    <MudTable Items="_items"
              Loading="_loading"
              Hover="true"
              Striped="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              NoRecordsText="Nema lokacija koje odgovaraju filterima.">
        <HeaderContent>
            <MudTh>Naziv</MudTh>
            <MudTh>Vrsta</MudTh>
            <MudTh>Adresa</MudTh>
            <MudTh>Grad</MudTh>
            <MudTh>Zaposlenici</MudTh>
            <MudTh>Prijave</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Akcije</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Naziv">@context.Name</MudTd>
            <MudTd DataLabel="Vrsta">@context.LocationTypeName</MudTd>
            <MudTd DataLabel="Adresa">@context.Address</MudTd>
            <MudTd DataLabel="Grad">@context.City</MudTd>
            <MudTd DataLabel="Zaposlenici">@context.EmployeeCount</MudTd>
            <MudTd DataLabel="Prijave">@context.FaultReportCount</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Aktivna" : "Neaktivna")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Akcije">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="@(() => OpenEdit(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(() => ConfirmDelete(context))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager RowsPerPageString="Redova po stranici:" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private List<LocationDto> _items = new();
    private List<LookupDto> _locationTypes = new();

    private string? _search;
    private int? _locationTypeId;
    private bool? _isActive;
    private bool _loading=true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await CurrentUser.InitializeAsync();

        _locationTypes = await LookupService.GetLocationTypesAsync();
        await LoadData();

        StateHasChanged();
    }

    private async Task LoadData()
    {
        _loading = true;
        _items = await LocationService.GetAllAsync(_search, _locationTypeId, _isActive);
        _loading = false;
    }

    private async Task OnTypeChanged(int? value)
    {
        _locationTypeId = value;
        await LoadData();
    }

    private async Task OnActiveChanged(bool? value)
    {
        _isActive = value;
        await LoadData();
    }

    private async Task ResetFilters()
    {
        _search = null;
        _locationTypeId = null;
        _isActive = null;
        await LoadData();
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<LocationDialog>
        {
            { x => x.LocationTypes, _locationTypes }
        };

        var dialog = await DialogService.ShowAsync<LocationDialog>("Nova lokacija", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            Snackbar.Add("Lokacija je dodana.", Severity.Success);
            await LoadData();
        }
    }

    private async Task OpenEdit(LocationDto item)
    {
        var parameters = new DialogParameters<LocationDialog>
        {
            { x => x.Existing, item },
            { x => x.LocationTypes, _locationTypes }
        };

        var dialog = await DialogService.ShowAsync<LocationDialog>("Izmjena lokacije", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            Snackbar.Add("Lokacija je izmijenjena.", Severity.Success);
            await LoadData();
        }
    }

    private async Task ConfirmDelete(LocationDto item)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, $"Obrisati lokaciju \"{item.Name}\"? Radnja je nepovratna." },
            { x => x.ConfirmText, "Obriši" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Potvrda brisanja", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        var (success, error) = await LocationService.DeleteAsync(item.Id);

        if (success)
        {
            Snackbar.Add("Lokacija je obrisana.", Severity.Success);
            await LoadData();
        }
        else
        {
            Snackbar.Add(error ?? "Brisanje nije uspjelo.", Severity.Error);
        }
    }
}