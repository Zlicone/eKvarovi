@using eKvarovi.App.Services
@inject FaultReportService FaultReportService

<MudDialog>
    <DialogContent>
        <MudText>
            Zatvaranjem se prijava „@ReportTitle" označava kao dovršena i više se ne može mijenjati.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">
            @(_saving ? "Zatvaranje..." : "Zatvori prijavu")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int ReportId { get; set; }
    [Parameter] public string ReportTitle { get; set; } = string.Empty;

    private bool _saving;
    private string? _error;

    private async Task Save()
    {
        _saving = true;
        _error = null;

        var result = await FaultReportService.CloseAsync(ReportId);

        _saving = false;

        if (result.Success)
            MudDialog.Close(DialogResult.Ok(true));
        else
            _error = result.Error;
    }

    private void Cancel() => MudDialog.Cancel();
}