@using eKvarovi.Shared.Dtos
@using eKvarovi.App.Services
@inject FaultReportService FaultReportService

<MudDialog>
    <DialogContent>
        <MudText Class="mb-3">
            Zatvaranjem se prijava „@ReportTitle" označava kao dovršena i više se ne može mijenjati.
        </MudText>

        <MudSelect T="int" @bind-Value="_closedBy" Label="Zatvara *">
            @foreach (var emp in Employees)
            {
                <MudSelectItem T="int" Value="@emp.Id">@emp.FullName</MudSelectItem>
            }
        </MudSelect>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">
            @(_saving ? "Zatvaranje..." : "Zatvori prijavu")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int ReportId { get; set; }
    [Parameter] public string ReportTitle { get; set; } = string.Empty;
    [Parameter] public List<EmployeeDto> Employees { get; set; } = new();

    private int _closedBy;
    private bool _saving;
    private string? _error;

    private async Task Save()
    {
        if (_closedBy <= 0)
        {
            _error = "Odaberite tko zatvara prijavu.";
            return;
        }

        _saving = true;
        _error = null;

        var result = await FaultReportService.CloseAsync(ReportId, _closedBy);

        _saving = false;

        if (result.Success)
            MudDialog.Close(DialogResult.Ok(true));
        else
            _error = result.Error;
    }

    private void Cancel() => MudDialog.Cancel();
}