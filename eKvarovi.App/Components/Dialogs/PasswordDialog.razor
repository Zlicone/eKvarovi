@using eKvarovi.Shared.Dtos
@using eKvarovi.App.Services
@inject UserService UserService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Postavljanje nove lozinke za korisnika <b>@Username</b>.
            Korisniku je proslijedite sigurnim putem.
        </MudText>

        <MudForm @ref="_form" Model="_model">
            <MudTextField @bind-Value="_model.NewPassword"
                          Label="Nova lozinka *"
                          InputType="@(_show ? InputType.Text : InputType.Password)"
                          Required="true"
                          RequiredError="Lozinka je obavezna."
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_show ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _show = !_show)"
                          Validation="@(new Func<string, string?>(v =>
                                          string.IsNullOrEmpty(v) || v.Length >= 6
                                              ? null
                                              : "Lozinka mora imati najmanje 6 znakova."))" />
        </MudForm>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">
            @(_saving ? "Spremanje..." : "Postavi lozinku")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int UserId { get; set; }
    [Parameter] public string Username { get; set; } = string.Empty;

    private MudForm _form = default!;
    private ChangePasswordDto _model = new();
    private bool _show;
    private bool _saving;
    private string? _error;

    private async Task Save()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _saving = true;
        _error = null;

        var result = await UserService.ChangePasswordAsync(UserId, _model);

        _saving = false;

        if (result.Success)
            MudDialog.Close(DialogResult.Ok(true));
        else
            _error = result.Error;
    }

    private void Cancel() => MudDialog.Cancel();
}