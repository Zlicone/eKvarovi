@using eKvarovi.Shared.Dtos
@using eKvarovi.App.Services
@inject InterventionService InterventionService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-3">@Intervention.FaultReportTitle</MudText>

        @if (Editable)
        {
            <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background: var(--mud-palette-background-grey);">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int" @bind-Value="_materialId" Label="Materijal" Dense="true">
                            @foreach (var m in Materials)
                            {
                                <MudSelectItem T="int" Value="@m.Id">@m.Name (@m.UnitAbbreviation)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal" @bind-Value="_quantity"
                                         Label="Količina" Min="0.01m" Step="1m" Dense="true" />
                    </MudItem>
                    <MudItem xs="12" sm="2" Class="d-flex align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="AddMaterial" Disabled="_busy" FullWidth="true">
                            Dodaj
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                Intervencija je zatvorena, utrošak materijala više nije moguće mijenjati.
            </MudAlert>
        }

        <MudTable Items="_usages" Dense="true" Hover="true"
                  NoRecordsText="Još nije evidentiran nijedan materijal.">
            <HeaderContent>
                <MudTh>Materijal</MudTh>
                <MudTh>Količina</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Materijal">@context.MaterialName</MudTd>
                <MudTd DataLabel="Količina">@context.Quantity.ToString("0.##") @context.UnitAbbreviation</MudTd>
                <MudTd>
                    @if (Editable)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => RemoveMaterial(context.MaterialId))" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close">Zatvori</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public InterventionDto Intervention { get; set; } = default!;
    [Parameter] public List<MaterialDto> Materials { get; set; } = new();

    private List<InterventionMaterialDto> _usages = new();
    private int _materialId;
    private decimal _quantity = 1;
    private bool _busy;

    private bool Editable => Intervention.IsEditable;

    protected override async Task OnInitializedAsync()
    {
        _usages = await InterventionService.GetMaterialsAsync(Intervention.Id);
    }

    private async Task AddMaterial()
    {
        if (_materialId <= 0)
        {
            Snackbar.Add("Odaberite materijal.", Severity.Warning);
            return;
        }

        if (_quantity <= 0)
        {
            Snackbar.Add("Količina mora biti veća od nule.", Severity.Warning);
            return;
        }

        _busy = true;

        var (success, error) = await InterventionService.AddMaterialAsync(
            Intervention.Id,
            new MaterialUsageDto { MaterialId = _materialId, Quantity = _quantity });

        _busy = false;

        if (success)
        {
            _usages = await InterventionService.GetMaterialsAsync(Intervention.Id);
            _materialId = 0;
            _quantity = 1;
        }
        else
        {
            Snackbar.Add(error ?? "Dodavanje nije uspjelo.", Severity.Error);
        }
    }

    private async Task RemoveMaterial(int materialId)
    {
        var (success, error) = await InterventionService.RemoveMaterialAsync(Intervention.Id, materialId);

        if (success)
            _usages = await InterventionService.GetMaterialsAsync(Intervention.Id);
        else
            Snackbar.Add(error ?? "Uklanjanje nije uspjelo.", Severity.Error);
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}