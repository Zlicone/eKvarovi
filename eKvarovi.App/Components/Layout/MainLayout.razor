@inherits LayoutComponentBase
@using eKvarovi.App.Services
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@implements IDisposable

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudText Typo="Typo.h6">e-Kvarovi Županije</MudText>
        <MudSpacer />

        @if (CurrentUser.IsLoggedIn)
        {
            <MudText Typo="Typo.body2" Class="mr-3 d-none d-sm-flex">
                @(CurrentUser.User!.EmployeeName ?? CurrentUser.User.Username)
                (@string.Join(", ", CurrentUser.User.Roles))
            </MudText>

            <MudButton Color="Color.Inherit"
                       StartIcon="@Icons.Material.Filled.Logout"
                       OnClick="Logout">
                Odjava
            </MudButton>
        }
    </MudAppBar>

    <MudDrawer Open="true" Elevation="1" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-6 mt-16">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    protected override void OnInitialized()
    {
        CurrentUser.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await CurrentUser.InitializeAsync();

        if (!CurrentUser.IsLoggedIn)
            Nav.NavigateTo("/login", replace: true);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task Logout()
    {
        await CurrentUser.LogoutAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    public void Dispose()
    {
        CurrentUser.Changed -= OnChanged;
    }
}